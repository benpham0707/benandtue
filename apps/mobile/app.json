{
  "expo": {
    "name": "Bopomofo",
    "slug": "bopomofo",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bopomofo",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#F7F4EE"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bopomofo.app"
    },
    "android": {
      "package": "com.bopomofo.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EE"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
