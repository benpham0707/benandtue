# dependencies
node_modules
# The embedded pocketsapp demo bundle ships its assets under
# `assets/node_modules/...` (Metro emits paths that way). The blanket
# `node_modules` rule above catches that tree, so we explicitly re-include
# it here. Without this exception every font + icon PNG in the demo is
# silently dropped from commits and the deployed site renders empty
# squares for icons.
!apps/web/public/pocketsapp-demo/assets/node_modules/
!apps/web/public/pocketsapp-demo/assets/node_modules/**
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store
.pnpm-debug.log*

# build artifacts
.next/
out/
out-deploy/
build/
dist/
.turbo
# Same story as the `node_modules` exception above — Metro emits asset
# paths through the source tree, including `.../vector-icons/build/...`
# for icon fonts and `.../module/assets/...` for navigation glyphs. Keep
# the embedded demo bundle whole.
!apps/web/public/pocketsapp-demo/assets/**/build/
!apps/web/public/pocketsapp-demo/assets/**/build/**

# expo
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# native
ios/Pods
ios/build
android/.gradle
android/build
android/app/build
android/.idea
*.xcworkspace/xcuserdata
*.xcodeproj/xcuserdata

# testing
coverage

# misc
.DS_Store
*.pem
*.log
*.tsbuildinfo
next-env.d.ts

# env
.env*

# vercel
.vercel

# editor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea

# agent-local
.claude/
.tmp-screenshots/
